[Unit]
Description=ESP-Sniffer Pure Bash Self-Healing Service on %I
BindsTo=dev-%i.device
After=dev-%i.device

# Without this, systemd's default anti-flapping limit (5 restarts within any
# 10s window) kicks in: a real outage (Node-RED down, TCP connection
# refused) fails near-instantly, so RestartSec alone would burn through that
# budget in a few restarts and systemd would then stop restarting the unit
# at all -- no more retries until something manually restarts it. 0
# disables that limit, so Restart=always actually means "forever", matching
# this unit's name.
StartLimitIntervalSec=0

[Service]
Type=simple
# Optional: deploy/install.sh creates this once with NODE_RED_IP=127.0.0.1
# and never overwrites it again, so a customized IP (Node-RED on a
# different host) survives re-running install.sh. The leading "-" means
# it's fine if the file doesn't exist.
EnvironmentFile=-/etc/esp-sniffer/env
ExecStart=/usr/local/bin/esp_sniffer_bridge.sh /dev/%I
Restart=always
RestartSec=10s

# systemd ignores SIGPIPE for services by default. The bridge script's
# self-healing depends on the opposite: a write to a dead TCP connection
# must kill the process so Restart=always can bring it back with a fresh
# connection. With SIGPIPE ignored, that write just fails silently (bash
# prints "write error: Broken pipe" and moves on) and the script loops
# forever, discarding every line -- "active (running)" but never actually
# connected again. (The script also checks the write's exit status directly
# and exits on failure, so this isn't the only line of defense -- but it's
# the one that makes the original signal-based assumption true again.)
IgnoreSIGPIPE=no

# FIX: Force socat and the bash wrapper to exit instantly when stopped
KillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
